# El service worker siempre fresco: si se queda en caché, los teléfonos no se enteran de la versión nueva
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Los archivos de assets llevan huella en el nombre: pueden guardarse un año
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Seguridad para todas las páginas:
# - Solo esta misma web puede meter la app en un iframe (nadie de fuera la tapa con un botón falso).
# - La política de contenido va primero en modo "solo informe": el navegador anota en la consola lo
#   que bloquearía y no rompe nada. Cuando no salgan avisos se pasa a Content-Security-Policy.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://web.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
